{
  "uid": "ticketya-logs",
  "title": "TicketYa - Log centralizado",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "custom",
        "query": "api-gateway,auth-service,catalogo-service,ventas-service,preferencias-service,notificaciones-service,fila-service",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "nivel",
        "label": "Nivel",
        "type": "custom",
        "query": "ERROR,WARN,INFO",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "buscar",
        "label": "X-Correlation-Id (o cualquier texto)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lineas de log por servicio",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (servicio) (count_over_time({servicio=~\"$servicio\", nivel=~\"$nivel\"} |= \"$buscar\" [1m]))",
          "legendFormat": "{{servicio}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errores (ultimos 30 min)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({servicio=~\".+\", nivel=\"ERROR\"} [30m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs de todos los servicios (filtrar por X-Correlation-Id para ver el recorrido de un pedido)",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{servicio=~\"$servicio\", nivel=~\"$nivel\"} |= \"$buscar\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Bitacora de operaciones criticas (compras, devoluciones, cancelaciones, ingresos)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{servicio=~\".+\"} |= \"BITACORA\" |= \"$buscar\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}