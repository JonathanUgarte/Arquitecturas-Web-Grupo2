{"openapi":"3.1.0","info":{"title":"TicketYa - Servicio de Preferencias y Recomendaciones","description":"Preferencias de cada cliente e historial de compras (MongoDB), y recomendaciones de eventos. El historial se arma consumiendo el mensaje 'compra.confirmada' de RabbitMQ.\n\nSeguridad: por el gateway con 'Authorization: Bearer <JWT>', rol CLIENTE.","version":"2.0"},"servers":[{"url":"http://preferencias-service:8084","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Interno","description":"Uso exclusivo entre microservicios: no se publica en el gateway"},{"name":"Preferencias y recomendaciones","description":"Preferencias del cliente (ciudad, tipos de evento y artistas favoritos) y eventos sugeridos"}],"paths":{"/preferencias":{"get":{"tags":["Preferencias y recomendaciones"],"summary":"Ver mis preferencias y mi historial de compras (cliente)","operationId":"obtener","parameters":[{"name":"X-Usuario-Id","in":"header","description":"Id del cliente (lo completa el gateway a partir del JWT)","required":true,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"X-Rol","in":"header","description":"Rol (lo completa el gateway)","required":false,"schema":{"type":"string"},"example":"CLIENTE"}],"responses":{"200":{"description":"Perfil del cliente (vacio si todavia no cargo nada)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}},"403":{"description":"No es cliente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}}}},"put":{"tags":["Preferencias y recomendaciones"],"summary":"Actualizar mis preferencias (cliente)","description":"Los campos que no se envian (null) quedan como estaban. Una lista vacia borra esa preferencia.","operationId":"actualizar","parameters":[{"name":"X-Usuario-Id","in":"header","description":"Id del cliente (lo completa el gateway a partir del JWT)","required":true,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"X-Rol","in":"header","description":"Rol (lo completa el gateway)","required":false,"schema":{"type":"string"},"example":"CLIENTE"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreferenciasRequest"}}},"required":true},"responses":{"200":{"description":"Preferencias guardadas","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}},"400":{"description":"Tipo de evento invalido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}},"403":{"description":"No es cliente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}},"409":{"description":"El perfil se modifico al mismo tiempo, reintentar","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerfilDTO"}}}}}}},"/recomendaciones":{"get":{"tags":["Preferencias y recomendaciones"],"summary":"Eventos recomendados para mi (cliente)","description":"Combina 'quienes compraron lo mismo que vos tambien compraron...', artistas y tipos favoritos, tipos comprados antes y ciudad. Cada recomendacion explica sus motivos. Sin datos, sugiere los proximos eventos a la venta.","operationId":"recomendar","parameters":[{"name":"X-Usuario-Id","in":"header","description":"Id del cliente (lo completa el gateway a partir del JWT)","required":true,"schema":{"type":"integer","format":"int64"},"example":1},{"name":"X-Rol","in":"header","description":"Rol (lo completa el gateway)","required":false,"schema":{"type":"string"},"example":"CLIENTE"},{"name":"limite","in":"query","description":"Cantidad maxima de recomendaciones (1 a 50)","required":false,"schema":{"type":"integer","format":"int32","default":10},"example":10}],"responses":{"200":{"description":"Eventos recomendados, del mas al menos relevante","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RecomendacionDTO"}}}}},"403":{"description":"No es cliente","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RecomendacionDTO"}}}}},"503":{"description":"El catalogo no responde","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RecomendacionDTO"}}}}}}}},"/interno/interesados":{"get":{"tags":["Interno"],"summary":"Clientes de una ciudad que tienen como favorito a alguno de estos artistas","operationId":"interesados","parameters":[{"name":"ciudad","in":"query","required":true,"schema":{"type":"string"}},{"name":"artistas","in":"query","required":true,"schema":{"type":"array","items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"type":"integer","format":"int64"}}}}}}}}},"components":{"schemas":{"PreferenciasRequest":{"type":"object","properties":{"ciudad":{"type":"string","example":"Tandil"},"tiposFavoritos":{"type":"array","description":"RECITAL, TEATRO, DEPORTE, CONFERENCIA, FESTIVAL u OTRO","example":["RECITAL","TEATRO"],"items":{"type":"string"},"uniqueItems":true},"artistasFavoritos":{"type":"array","example":["Banda Uno"],"items":{"type":"string"},"uniqueItems":true}}},"CompraHistorialDTO":{"type":"object","properties":{"compraId":{"type":"integer","format":"int64"},"eventoId":{"type":"integer","format":"int64"},"nombreEvento":{"type":"string"},"tipo":{"type":"string"},"participantes":{"type":"array","items":{"type":"string"}},"ciudad":{"type":"string"},"fecha":{"type":"string","format":"date-time"}}},"PerfilDTO":{"type":"object","properties":{"usuarioId":{"type":"integer","format":"int64"},"ciudad":{"type":"string"},"tiposFavoritos":{"type":"array","items":{"type":"string"},"uniqueItems":true},"artistasFavoritos":{"type":"array","items":{"type":"string"},"uniqueItems":true},"historial":{"type":"array","items":{"$ref":"#/components/schemas/CompraHistorialDTO"}}}},"RecomendacionDTO":{"type":"object","properties":{"eventoId":{"type":"integer","format":"int64"},"nombre":{"type":"string"},"tipo":{"type":"string"},"ciudad":{"type":"string"},"fechaHora":{"type":"string","format":"date-time"},"precioDesde":{"type":"number"},"puntaje":{"type":"integer","format":"int32"},"motivos":{"type":"array","items":{"type":"string"}}}}},"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}}}}