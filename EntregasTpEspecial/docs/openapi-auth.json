{"openapi":"3.1.0","info":{"title":"TicketYa - Servicio de Autenticacion","description":"Registro de clientes, login y alta de usuarios con rol. El login devuelve un JWT que se envia en el header 'Authorization: Bearer <token>' a traves del gateway. Roles: CLIENTE, ORGANIZADOR, ADMIN y ACCESO (personal de acceso).","version":"2.0"},"servers":[{"url":"http://auth-service:8083","description":"Generated server url"}],"tags":[{"name":"Autenticacion","description":"Registro, login (emite el JWT) y alta de usuarios con rol"}],"paths":{"/auth/usuarios":{"get":{"tags":["Autenticacion"],"summary":"Listar usuarios (administrador)","operationId":"listar","responses":{"200":{"description":"Usuarios registrados","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UsuarioDTO"}}}}},"403":{"description":"No es administrador","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UsuarioDTO"}}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Autenticacion"],"summary":"Dar de alta un usuario con cualquier rol (administrador)","operationId":"alta","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AltaUsuarioRequest"}}},"required":true},"responses":{"201":{"description":"Usuario creado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioDTO"}}}},"401":{"description":"Sin token o token invalido (lo responde el gateway)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioDTO"}}}},"403":{"description":"No es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioDTO"}}}},"409":{"description":"Ya existe un usuario con ese email","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UsuarioDTO"}}}}},"security":[{"bearerAuth":[]}]}},"/auth/registro":{"post":{"tags":["Autenticacion"],"summary":"Registrarse como cliente (publico)","operationId":"registrar","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegistroR